#!/bin/bash

# Initialize
AFTER=""
BEFORE=""
IP=""
URI=""
CMD=""
LOGS=""

read_file() {
  if [[ -z "$LOGS" ]]; then
    cat
  else
    for log in $LOGS; do
      case "$log" in
        *.gz) gzip -dc "$log" ;;
        *) cat "$log" ;;
      esac
    done
  fi
}


while [[ $# -gt 0 ]]; do
  case "$1" in      
    -a)
      AFTER="$2"
      shift 2
      ;;
    -b)
      BEFORE="$2"
      shift 2
      ;;
    -ip)
      IP="$2"
      shift 2
      ;;
    -uri)
      URI="$2"
      shift 2
      ;;
    list-ip|list-hosts|list-uri|hist-ip|hist-load)
      if [[ -n "$COMMAND" ]]; then
        echo "Error: Cannot have multiple commands: '$COMMAND' and '$1'" >&2
      fi 
      COMMAND="$1"
      shift 1
      ;;
    -*)
      echo "Error: Invalid option: '$1'" >&2
      exit 1
      ;;
    *)
      if [[ -f "$1" ]]; then
        LOGS="$LOGS $1"
        shift 1
      else
        echo "Error: '$1' is neither valid command or existing file." >&2
        exit 1
      fi
      ;;
  esac
done

echo "All logs: ${LOGS[@]}"

read_file >&1