#!/bin/bash

# Initialize

AFTER=""
BEFORE=""
IP=""
URI=""
CMD=""
LOGS=""


while [[ $# -gt 0 ]]; do
  case $1 in      
    -a)
      AFTER=$2
      shift 2
      ;;
    -b)
      BEFORE=$2
      shift 2
      ;;
    -ip)
      IP=$2
      shift 2
      ;;
    -uri)
      URI=$2
      shift 2
      ;;
    list-ip | list-hosts | list-uri | hist-ip | hist-load)
      COMMAND=$1
      shift 1
      ;;
    -*)
      echo "Error: Invalid option: '$1'"
      exit 1
      ;;
    *)
      if [[ -f $1 ]]; then
        LOGS="$LOGS $1"
      else
        echo "Error: '$1' is neither valid command or existing file."
        exit 1
      fi
      shift 1
      ;;
  esac
done

echo "All logs: ${LOGS[@]}"